{
  "name": "spck",
  "version": "0.6.1",
  "description": "CLI tool for Spck Editor - provides remote filesystem, git, browser proxing, and terminal access",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "spck": "./bin/cli.js"
  },
  "scripts": {
    "build": "tsc && cp src/i18n/locales/*.json dist/i18n/locales/",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "watch": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepublishOnly": "npm run lint && npm test",
    "prepare": "npm run build"
  },
  "keywords": [
    "spck",
    "editor",
    "remote",
    "filesystem",
    "git",
    "terminal"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/spck-io/spck-cli"
  },
  "author": "Spck Editor",
  "license": "MIT",
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.100.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/headless": "6.0.0",
    "chalk": "6.0.1",
    "chokidar": "6.0.0",
    "default-shell": "2.2.0",
    "fossil-delta": "2.0.0",
    "jsonwebtoken": "9.0.3",
    "node-fetch": "3.3.2",
    "node-pty": "1.2.0-beta.18",
    "open": "11.0.4",
    "os-locale": "8.0.0",
    "pyright": "1.1.414",
    "qrcode-terminal": "0.12.0",
    "socket.io-client": "4.8.4",
    "typescript": "5.9.3",
    "typescript-language-server": "6.0.3",
    "write-file-atomic": "8.0.0",
    "yargs": "18.2.0"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "22.20.5",
    "@types/qrcode-terminal": "0.12.2",
    "@types/write-file-atomic": "4.0.3",
    "@types/ws": "8.18.2",
    "@types/yargs": "17.0.35",
    "oxlint": "1.90.0",
    "ts-node": "10.9.2",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "optionalDependencies": {
    "node-datachannel": "0.33.6"
  }
}
